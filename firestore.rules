
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles: Only owner can write, authenticated users can read basic info
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // History/Version Tracking: Only owner can access their own history, Developers can see all
    match /history/{historyId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DEVELOPER'
      );
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    
    // Collaborations: Participants can read/write shared data
    match /collaborations/{collabId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.participants);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid in resource.data.participants);
    }
    
    // Collaborative Projects
    match /projects/{projectId} {
      allow read, write: if request.auth != null && (request.auth.uid in resource.data.collaborators);
    }

    // Intelligence Archive: Read-only for all operators
    match /case_studies/{studyId} {
      allow read: if request.auth != null;
    }

    // Contact Submissions: Authenticated users can create, owners/devs can read
    match /contacts/{contactId} {
      allow create: if true; 
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DEVELOPER'
      );
    }

    // CRM propositions
    match /propositions/{propId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DEVELOPER'
      );
      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DEVELOPER';
    }

    // Premium Consultant Repo: Only authorized premium operators
    match /premium_consultant_repo/{repoId} {
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'PREMIUM_OPERATOR';
    }
  }
}
